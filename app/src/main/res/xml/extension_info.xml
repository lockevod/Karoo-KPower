<?xml version="1.0" encoding="utf-8"?>
<!--
  Cross-extension consumption: every DataType below is addressable by any other Karoo extension via
  KarooSystemService.streamDataFlow(DataType.dataTypeId("kpower", "<typeId>")), which resolves to the
  id "TYPE_EXT::kpower::<typeId>" (e.g. TYPE_EXT::kpower::real-power-0, TYPE_EXT::kpower::dyn-balance-0).
  The estimated fields run the estimator on demand; the real-meter / dynamics fields only stream while
  a meter is enabled AND the ride is recording (battery gate). Real power+cadence are ALSO exposed as a
  standard pairable POWER/CADENCE sensor ("KPW …"), which is the most interoperable path for power.
-->
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_power_hr"
    id="kpower"
    fitFile="true"
    scansDevices="true">
    <DataType
        typeId="estimated-power-instant"
        displayName="@string/est_instant_name"
        description="@string/est_instant_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType
        typeId="estimated-power-3s"
        displayName="@string/est_3s_name"
        description="@string/est_3s_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType
        typeId="estimated-power-np"
        displayName="@string/est_np_name"
        description="@string/est_np_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType
        typeId="estimated-power-avg"
        displayName="@string/est_avg_name"
        description="@string/est_avg_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType typeId="real-power-0" displayName="@string/real1_name" description="@string/real1_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-3s-0" displayName="@string/real1_3s_name" description="@string/real1_3s_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-np-0" displayName="@string/real1_np_name" description="@string/real1_np_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-avg-0" displayName="@string/real1_avg_name" description="@string/real1_avg_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-balance-0" displayName="@string/dyn_balance_name" description="@string/dyn_balance_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-te-0" displayName="@string/dyn_te_name" description="@string/dyn_te_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-ps-0" displayName="@string/dyn_ps_name" description="@string/dyn_ps_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-pp-left-0" displayName="@string/dyn_pp_left_name" description="@string/dyn_pp_left_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-pp-right-0" displayName="@string/dyn_pp_right_name" description="@string/dyn_pp_right_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-peakpp-left-0" displayName="@string/dyn_peakpp_left_name" description="@string/dyn_peakpp_left_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-peakpp-right-0" displayName="@string/dyn_peakpp_right_name" description="@string/dyn_peakpp_right_desc" graphical="false" icon="@drawable/ic_power_hr" />
</ExtensionInfo>
