<?xml version="1.0" encoding="utf-8"?>
<!--
  Cross-extension consumption: every DataType below is addressable by any other Karoo extension via
  KarooSystemService.streamDataFlow(DataType.dataTypeId("kpower", "<typeId>")), which resolves to the
  id "TYPE_EXT::kpower::<typeId>" (e.g. TYPE_EXT::kpower::real-power-0, TYPE_EXT::kpower::dyn-te-0).
  The estimated fields run the estimator on demand; the real-meter / dynamics fields only stream while
  a meter is enabled AND the ride is recording (battery gate). Real power+cadence are ALSO exposed as a
  standard pairable POWER/CADENCE sensor ("KPOWER …"), which is the most interoperable path for power.
-->
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_power_hr"
    id="kpower"
    fitFile="true"
    scansDevices="true">
    <DataType
        typeId="estimated-power-instant"
        displayName="@string/est_instant_name"
        description="@string/est_instant_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType
        typeId="estimated-power-3s"
        displayName="@string/est_3s_name"
        description="@string/est_3s_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType
        typeId="estimated-power-np"
        displayName="@string/est_np_name"
        description="@string/est_np_desc"
        graphical="false"
        icon="@drawable/ic_power_hr" />
    <DataType typeId="real-power-0" displayName="@string/real1_name" description="@string/real1_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-3s-0" displayName="@string/real1_3s_name" description="@string/real1_3s_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-np-0" displayName="@string/real1_np_name" description="@string/real1_np_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-cadence-0" displayName="@string/real1_cad_name" description="@string/real1_cad_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-torque-0" displayName="@string/real1_torque_name" description="@string/real1_torque_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-avgtorque-0" displayName="@string/real1_avgtorque_name" description="@string/real1_avgtorque_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <DataType typeId="real-maxtorque-0" displayName="@string/real1_maxtorque_name" description="@string/real1_maxtorque_desc" graphical="false" icon="@drawable/ic_power_hr" />
    <!-- Balance fields removed: the Karoo shows pedal balance natively; KPower still writes it to the FIT
         (standard left_right_balance). -->
    <DataType typeId="dyn-te-0" displayName="@string/dyn_te_name" description="@string/dyn_te_desc" graphical="true" icon="@drawable/ic_power_hr" />
    <DataType typeId="dyn-ps-0" displayName="@string/dyn_ps_name" description="@string/dyn_ps_desc" graphical="true" icon="@drawable/ic_power_hr" />
    <!-- Per-side single streamable fields (balance/avgbalance/te/ps -left/-right) and power-phase fields
         removed: nothing consumed them. Balance + power-phase are still written to the FIT. -->
</ExtensionInfo>
